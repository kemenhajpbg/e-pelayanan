<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keamanan: Blokir akses langsung ke file konfigurasi dan folder sistem Laravel
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|artisan) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests)/ - [F,L,NC]

    # Arahkan seluruh request publik ke folder /public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L,QSA]
</IfModule>
